{
  "name": "portfolio",
  "homepage": "https://vncsmyrnk.github.io/portfolio/",
  "private": true,
  "version": "0.0.1",
  "packageManager": "pnpm@10.33.0",
  "type": "module",
  "engines": {
    "node": ">=26.1.0",
    "pnpm": ">=10.33.0"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev-bundle": "vite --host --port 3000",
    "watch-tsc": "tsc --watch --noEmit",
    "dev": "run-p dev-bundle watch-tsc",
    "build": "tsc && vite build",
    "format": "npx prettier src/ --write",
    "format-check": "npx prettier src/ --check",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview"
  },
  "dependencies": {
    "@eslint/compat": "^2.1.0",
    "@fontsource/ubuntu": "^5.2.8",
    "@types/react-syntax-highlighter": "^15.5.13",
    "flag-icons": "^7.5.0",
    "i18next": "^26.1.0",
    "i18next-http-backend": "^4.0.0",
    "npm-run-all": "^4.1.5",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-i18next": "^17.0.7",
    "react-icons": "^5.6.0",
    "react-multi-carousel": "^2.8.6",
    "react-syntax-highlighter": "npm:@fengkx/react-syntax-highlighter@15.6.1"
  },
  "devDependencies": {
    "@types/prop-types": "^15.7.15",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "postcss": "^8.5.14",
    "prettier": "^3.8.3",
    "prop-types": "^15.8.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^8.0.12"
  }
}
